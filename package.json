{
	"name": "praetorium",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"worker:dev": "wrangler dev",
		"worker:types": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply praetorium-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply praetorium-db --remote",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"lucide-react": "^0.525.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"playwright": "^1.49.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.0",
		"wrangler": "^4.0.0"
	}
}
