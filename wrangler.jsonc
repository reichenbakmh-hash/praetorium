{
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "praetorium",

	"main": "./worker/worker.ts",

	"compatibility_date": "2026-08-12",

	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "praetorium-db",
			"database_id": "4de71e90-4a39-4db1-a18e-184f5fa6bf28",
			"migrations_dir": "./migrations"
		}
	]
}
